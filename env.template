# Same variable names as python-github-plus, so one .env serves both.
GITHUB_ACCESS_TOKEN='your token'
# GITHUB_BASE_URL='https://github.example.com/api/v3'   # GitHub Enterprise Server only

GITHUB_MCP_DEFAULT_REPO=''                # owner/name used when a tool call gives no repo
GITHUB_MCP_READ_ONLY=true                 # false registers the write tools
GITHUB_MCP_ENABLE_DESTRUCTIVE=false       # true (and read-only false) registers merge and delete tools
GITHUB_MCP_TRANSPORT=stdio                # stdio | streamable-http
GITHUB_MCP_HOST=127.0.0.1                 # streamable-http only; 0.0.0.0 in Docker
GITHUB_MCP_PORT=8000
GITHUB_MCP_MAX_RESULTS=100                # upper bound for any `limit`
GITHUB_MCP_MAX_FILE_CHARS=100000          # longer file contents are cut and flagged `truncated`

# Integration tests (pytest -m integration)
# GITHUB_TEST_REPO='your-user/sandbox-repo'   # creates and deletes temp branches, PRs, tags
